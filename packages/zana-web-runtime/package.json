{
  "name": "@vecanova/zana-web-runtime",
  "version": "0.1.0",
  "description": "Offline conversational runtime for ZANA Aeons on the web \u2014 memory, pattern detection, reflection and personality evolution. Zero LLM dependency for v0.",
  "type": "module",
  "main": "dist/runtime.js",
  "types": "dist/runtime.d.ts",
  "exports": {
    ".": {
      "import": "./dist/runtime.js",
      "types": "./dist/runtime.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "zana",
    "aeon",
    "pwa",
    "offline",
    "local-first"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vecanova/zana-web-persistence-file": "file:../zana-web-persistence",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "private": true,
  "dependencies": {
    "@vecanova/zana-web-persistence": "file:../zana-web-persistence"
  }
}